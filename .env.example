# Copy to .env and fill in values. Everything here is optional.

# --- OCR service ---
PORT=7860
GLM_BASE_URL=http://localhost:8080/v1
GLM_MODEL=glm-ocr
MAX_PDF_PAGES=8
MAX_UPLOAD_MB=25
MAX_TOKENS=4096
REQUEST_TIMEOUT_MS=900000

# Optional: API key sent to the model server as "Authorization: Bearer <key>".
# Needed only for cloud OpenAI-compatible providers; local llama-server ignores it.
LLM_API_KEY=

# --- Supabase (storage mode "supabase") ---
# Connection string from Supabase Dashboard -> Settings -> Database ->
# Connection string -> URI. Replace [YOUR-PASSWORD] with the database password.
# When set, the service creates the ocr_extractions table automatically and
# writes rows for profiles with storage: "supabase".
SUPABASE_DB_URL=
